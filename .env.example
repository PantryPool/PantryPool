PORT=3000
NODE_ENV=production
APP_URL="https://pantrypool.com"

# Google OAuth 2.0 Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
VITE_GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"

# Multi-Tenancy / Organization Workspace Feature Flag (true for SaaS, false for Open-Core)
VITE_ENABLE_ORGANIZATIONS="false"

# Google Analytics 4 Measurement ID (Optional - client-side telemetry)
# VITE_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# MySQL Database Configuration (Namecheap cPanel / Local MySQL)
DATABASE_URL="mysql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:3306/YOUR_DB_NAME"
DB_HOST="localhost"
DB_PORT=3306
DB_USER="YOUR_DB_USER"
DB_PASS="YOUR_DB_PASSWORD"
DB_NAME="YOUR_DB_NAME"

# Server-Side Gemini AI API Key (Optional - for AI Receipt Scanning)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
# Optional: Override AI receipt OCR model (defaults to gemini-2.5-flash-lite for sub-second latency)
# GEMINI_OCR_MODEL="gemini-2.5-flash-lite"

# Server-Side TypeSafe AI API Key (Optional - for System One / Jev structured parsing & entity deduplication)
TYPESAFE_API_KEY="YOUR_TYPESAFE_API_KEY"

# JWT Authentication Secret (REQUIRED - generate a strong random string)
JWT_SECRET="CHANGE_ME_TO_A_STRONG_RANDOM_SECRET"

# Initial superadmin email (OPTIONAL - if omitted, the very first user who registers on an empty database becomes superadmin)
INITIAL_ADMIN_EMAIL="admin@yourdomain.com"

# Dependabot PR Automation & Telegram SRE Alerts
GITHUB_TOKEN="YOUR_GITHUB_PERSONAL_ACCESS_TOKEN"
REPO_OWNER="your-github-username"
REPO_NAME="PantryPool"
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
TELEGRAM_CHAT_ID="YOUR_TELEGRAM_CHAT_ID"

# SMTP Email Delivery Configuration (SSL/TLS port 465)
SMTP_HOST="smtp.yourdomain.com"
SMTP_PORT=465
SMTP_USER="admin@yourdomain.com"
SMTP_PASS="YOUR_SMTP_PASSWORD"
SMTP_FROM_EMAIL="admin@yourdomain.com"
SMTP_FROM_NAME="PantryPool"

# Internal Email Relay Configuration (Optional - for Edge / Serverless environments)
EMAIL_RELAY_URL="https://relay.yourdomain.com/api/internal/send-email"
EMAIL_RELAY_SECRET="YOUR_STRONG_RANDOM_RELAY_SECRET"

