{
  "name": "pantrypool",
  "private": false,
  "version": "1.0.0",
  "license": "FSL-1.1-MIT",
  "author": {
    "name": "PantryPool Cloud Team",
    "url": "https://pantrypool.com"
  },
  "contributors": [
    "Google Gemini <ai@google.com>",
    "Donald Fellow"
  ],
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "setup:cloudflare": "./scripts/setup_cloudflare.sh",
    "audit:licenses": "npx license-checker-rseidelsohn --summary --excludePrivatePackages",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --external:vite --external:esbuild --external:fsevents --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "test": "vitest run",
    "test:security": "vitest run tests/crossTenantSecurity.test.ts",
    "test:ai": "tsx scripts/test_gemini_models.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:e2e:live": "playwright test --config=playwright.live.config.ts",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts --config=playwright.config.ts",
    "test:perf": "playwright test tests/e2e/performance-vitals.spec.ts --config=playwright.config.ts",
    "test:stress": "tsx scripts/stress_test_api.ts",
    "test:stress:prod": "tsx scripts/prod_stress_test.ts",
    "test:locust": "./scripts/run_locust.sh",
    "test:locust:headless": "./scripts/run_locust.sh --headless",
    "test:locust:preseed": "python3 scripts/create_locust_users.py",
    "test:all": "npm test && npm run test:e2e",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit && tsc --project tsconfig.functions.json --noEmit",
    "lint:functions": "tsc --project tsconfig.functions.json --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply pantrypool-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply pantrypool-db --remote",
    "db:migrate:list": "wrangler d1 migrations list pantrypool-db --local",
    "make-superadmin": "tsx scripts/make_superadmin.ts",
    "dr:staged-backup": "tsx scripts/staged_d1_backup.ts"
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "@hono/node-server": "^2.1.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.2",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "google-auth-library": "^11.0.2",
    "hono": "^4.13.8",
    "jsonwebtoken": "^9.0.3",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.46.0",
    "motion": "^13.3.0",
    "mysql2": "^3.24.4",
    "nodemailer": "^10.0.10",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "stripe": "^22.6.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "^5.20260916.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.5.1",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.0",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "undici": "^6.21.0",
    "qs": "^6.16.0"
  },
  "description": "The source-available breakroom & shared pantry ledger."
}
