{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "strict": false,
    "types": ["@cloudflare/workers-types", "node"],
    "noEmit": true
  },
  "include": ["functions/**/*.ts"]
}
